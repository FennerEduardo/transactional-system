# syntax=docker/dockerfile:1
# Production image generated by gherkin-ai (C# · ASP.NET Core 8 + EF Core).
# Configure it with environment variables only: DATABASE_URL, AMQP_URL, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT.
# Listens on 8080; probes: liveness /health, readiness /health.

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish transactional-system.csproj -c Release -o /app --nologo

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://0.0.0.0:8080 DOTNET_CLI_TELEMETRY_OPTOUT=1
# The aspnet image ships a non-root "app" user.
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "transactional-system.dll"]
